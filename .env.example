# Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret — change this to a strong random string in production
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Database — SQLite file path (relative to backend folder)
DB_STORAGE=./database.sqlite

# CORS — comma-separated origins allowed (no spaces)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
